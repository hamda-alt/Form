# MySQL connection — either a single URL:
DATABASE_URL="mysql://root:password@localhost:3306/clickup_forms"

# ...or discrete vars (used only if DATABASE_URL is not set):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=clickup_forms

# Public base URL (used to build shareable /f/<id> links). Optional.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
